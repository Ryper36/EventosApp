
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EventosApp.Models"
             x:Class="EventosApp.Views.CadastroEventoPage"
             Title="Cadastro de Evento">

    <ContentPage.BindingContext>
        <models:Evento />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout
            Spacing="10"
            Padding="20"
            VerticalOptions="StartAndExpand">

            <Label Text="Nome do Evento:" />
            <Entry Text="{Binding Nome}" Placeholder="Digite o nome do evento" />

            <Label Text="Data de Início:" />
            <DatePicker Date="{Binding DataInicio}" Format="D" />

            <Label Text="Data de Término:" />
            <DatePicker Date="{Binding DataTermino}" Format="D" />

            <Label Text="Número de Participantes:" />
            <Entry Text="{Binding NumeroParticipantes}" Keyboard="Numeric" Placeholder="Informe o número de participantes" />

            <Label Text="Local do Evento:" />
            <Entry Text="{Binding Local}" Placeholder="Digite o local do evento" />

            <Label Text="Custo por Participante:" />
            <Entry Text="{Binding CustoPorParticipante}" Keyboard="Numeric" Placeholder="Informe o custo por participante" />

            <Button Text="Cadastrar Evento" Clicked="OnCadastrarEventoClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
